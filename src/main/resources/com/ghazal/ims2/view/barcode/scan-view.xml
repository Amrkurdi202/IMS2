<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://com.ghazal.ims2/menu.barcodeScan"
      focusComponent="barcodeField">

    <data>
        <collection id="warehousesDc" class="com.ghazal.ims2.entity.Warehouse">
            <fetchPlan extends="_base">
                <property name="name"/>
                <property name="internal"/>
                <property name="latitude"/>
                <property name="longitude"/>
            </fetchPlan>
            <loader id="warehousesDl">
                <query><![CDATA[
                    select w from Warehouse w
                    where w.internal = true
                    order by w.name
                ]]></query>
            </loader>
        </collection>
    </data>

    <facets>
        <dataLoadCoordinator auto="false"/>
    </facets>

    <layout>
        <vbox spacing="true" padding="true" classNames="scan-shell">

            <hbox spacing="true" alignItems="CENTER">
                <button id="takeBtn"
                        text="msg://com.ghazal.ims2.view.barcode/barcode.modeTake"
                        themeNames="primary"/>
                <button id="checkInBtn"
                        text="msg://com.ghazal.ims2.view.barcode/barcode.modeCheckIn"/>
            </hbox>

            <hbox spacing="true" alignItems="END">
                <entityComboBox id="warehouseField"
                                metaClass="Warehouse"
                                itemsContainer="warehousesDc"
                                label="msg://com.ghazal.ims2.view.report/warehouseInternal"
                                required="true"
                                width="320px"/>
                <span id="gpsTag" text="(GPS)" visible="false"/>
            </hbox>

            <textField id="barcodeField"
                       label="msg://com.ghazal.ims2.view.barcode/barcode.scanField"
                       classNames="barcode-input"
                       width="100%"
                       maxLength="100"/>

            <numberField id="qtyField"
                         label="msg://com.ghazal.ims2.view.barcode/barcode.qty"
                         min="0.001"
                         step="0.001"
                         width="180px"/>

            <span id="currentItemLabel" text="msg://com.ghazal.ims2.view.barcode/barcode.noCurrent"/>

            <span id="statusLabel" text="msg://com.ghazal.ims2.view.barcode/barcode.statusReady"/>

            <vbox id="linesHost" spacing="true"/>

        </vbox>
    </layout>
</view>