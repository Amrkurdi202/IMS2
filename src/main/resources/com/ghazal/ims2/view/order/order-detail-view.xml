<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://OrderDetailView.title"
      focusComponent="form">

    <data>
        <instance id="orderDc"
                  class="com.ghazal.ims2.entity.Order">
            <fetchPlan extends="_base">
                <property name="warehouse" fetchPlan="_base"/>
                <property name="project" fetchPlan="_base"/>
                <property name="items" fetchPlan="_base"/>
            </fetchPlan>
            <loader/>
            <collection id="itemsDc" property="items"/>
        </instance>
    </data>

    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>

    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>

    <layout>

        <!-- Top form: user / warehouse / project -->
        <formLayout id="form" dataContainer="orderDc">
            <entityPicker id="userField"
                          property="user"
                          readOnly="true">
                <actions>
                    <action id="lookup" type="entity_lookup"/>
                    <action id="clear" type="entity_clear"/>
                </actions>
            </entityPicker>


            <entityPicker id="warehouseField"
                          property="warehouse"
                          required="true"
                          requiredMessage="Warehouse is required">
                <actions>
                    <action id="lookup" type="entity_lookup"/>
                    <action id="clear" type="entity_clear"/>
                </actions>
            </entityPicker>

            <entityPicker id="projectField"
                          property="project"
                          required="true"
                          requiredMessage="Project is required">
                <actions>
                    <action id="lookup" type="entity_lookup"/>
                    <action id="clear" type="entity_clear"/>
                </actions>
            </entityPicker>

        </formLayout>

        <vbox width="100%">

            <!-- Buttons for managing order lines -->
            <hbox classNames="buttons-panel">
                <button id="addItemBtn" text="Add item"/>


            </hbox>
            <hbox id="qtyActions">
                <button id="qtyMinusBtn"
                        text="Qty -">

                </button>


                <button id="qtyPlusBtn"
                        text="Qty +">
                /button>
                </button>

            </hbox>


            <!-- Items grid: ONLY simple property columns -->
            <dataGrid id="itemsDataGrid"
                      width="100%"
                      dataContainer="itemsDc"
                      editorBuffered="true"
                      minHeight="15em">

                <actions>
                    <action id="create" type="list_create"/>
                    <action id="edit" type="list_edit"/>
                    <action id="remove" type="list_remove"/>
                </actions>

                <columns>
                    <!-- Normal catalog item -->
                    <column property="item" editable="true"/>

                    <!-- Is this a custom ad-hoc item? -->
                    <column property="customItem" header="Custom?" editable="true"/>

                    <!-- Free text name when customItem = true -->
                    <column property="customName" header="Custom name" editable="true"/>

                    <!-- Quantity (for normal items) or price (for custom items) -->
                    <column property="quantity" header="Qty / Price" editable="true"/>

                    <!-- We dropped the generated Qty +/- column to keep things stable -->
                    <editorActionsColumn>
                        <editButton icon="PENCIL"/>
                        <saveButton icon="CHECK" themeNames="success"/>
                        <cancelButton icon="CLOSE" themeNames="error"/>
                    </editorActionsColumn>
                </columns>
            </dataGrid>


        </vbox>

        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>

    </layout>
</view>
