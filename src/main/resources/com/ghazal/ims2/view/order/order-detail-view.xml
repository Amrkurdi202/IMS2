<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://OrderDetailView.title"
      focusComponent="form">
    <data>
        <instance id="orderDc"
                  class="com.ghazal.ims2.entity.Order">
            <fetchPlan extends="_base">
                <property name="warehouse" fetchPlan="_base"/>
                <property name="project" fetchPlan="_base"/>
                <property name="items" fetchPlan="_base">
                </property>
            </fetchPlan>
            <loader/>
            <collection id="itemsDc" property="items"/>
        </instance>
    </data>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <layout>
        <formLayout id="form" dataContainer="orderDc">
            <entityPicker id="userField" property="user">
                <actions>
                    <action id="lookup" type="entity_lookup"/>
                    <action id="clear" type="entity_clear"/>
                </actions>
            </entityPicker>

            <entityPicker id="warehouseField" property="warehouse">
                <actions>
                    <action id="lookup" type="entity_lookup"/>
                    <action id="clear" type="entity_clear"/>
                </actions>
            </entityPicker>

            <entityPicker id="projectField" property="project">
                <actions>
                    <action id="lookup" type="entity_lookup"/>
                    <action id="clear" type="entity_clear"/>
                </actions>
            </entityPicker>

        </formLayout>
        <vbox width="100%">
            <hbox classNames="buttons-panel">
                <button id="addPointBtn" text="msg://addOrderItem"/>
                <button action="itemsDataGrid.edit"/>
                <button action="itemsDataGrid.remove"/>
            </hbox>
            <dataGrid id="itemsDataGrid"
                      width="100%"
                      dataContainer="itemsDc"
                      editorBuffered="true"
                      minHeight="15em">
                <actions>
                    <action id="create" type="list_create"/>
                    <action id="edit" type="list_edit"/>
                    <action id="remove" type="list_remove"/>
                </actions>
                <columns>
                    <column property="item" editable="true"/>
                    <column property="quantity" editable="true"/>
                    <editorActionsColumn>
                        <editButton icon="PENCIL"/>
                        <saveButton icon="CHECK" themeNames="success"/>
                        <cancelButton icon="CLOSE" themeNames="error"/>
                    </editorActionsColumn>
                </columns>
            </dataGrid>
        </vbox>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>