<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://OrderDetailView.title"
      focusComponent="form">

    <data>
        <instance id="orderDc"
                  class="com.ghazal.ims2.entity.Order">
            <fetchPlan extends="_base">
                <property name="warehouse" fetchPlan="_base"/>
                <property name="project" fetchPlan="_base"/>
                <property name="items">
                    <property name="item">
                        <property name="name"/>
                        <property name="image"/>
                    </property>
                    <property name="customItem"/>
                    <property name="customName"/>
                    <property name="quantity"/>
                </property>
            </fetchPlan>

            <loader/>
            <collection id="itemsDc" property="items"/>
        </instance>
    </data>

    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_discard"/>
    </actions>

    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>

    <layout>

        <!-- Top form: user / warehouse / project -->
        <formLayout id="form" dataContainer="orderDc">
            <entityPicker id="userField" property="user">
                <actions>
                    <action id="lookup" type="entity_lookup"/>
                    <action id="clear" type="entity_clear"/>
                </actions>
            </entityPicker>

            <entityPicker id="warehouseField" property="warehouse">
                <actions>
                    <action id="lookup" type="entity_lookup"/>
                    <action id="clear" type="entity_clear"/>
                </actions>
            </entityPicker>

            <entityPicker id="projectField" property="project">
                <actions>
                    <action id="lookup" type="entity_lookup"/>
                    <action id="clear" type="entity_clear"/>
                </actions>
            </entityPicker>
        </formLayout>

        <!-- 🔹 Split area: left = items grid, right = big image preview -->
        <hbox width="100%" spacing="true">

            <!-- LEFT: existing buttons + grid -->
            <vbox width="70%">

                <!-- Buttons for managing order lines -->
                <hbox classNames="buttons-panel">
                    <button id="addItemBtn" text="Add item"/>
                </hbox>


                <hbox id="qtyActions">
                    <button id="qtyMinusBtn" text="Qty -"/>
                    <button id="qtyPlusBtn" text="Qty +"/>
                </hbox>

                <!-- Items grid: ONLY simple property columns -->
                <dataGrid id="itemsDataGrid"
                          width="100%"
                          dataContainer="itemsDc"
                          editorBuffered="true"
                          minHeight="15em">

                    <actions>
                        <action id="create" type="list_create"/>
                        <action id="edit" type="list_edit"/>
                        <action id="remove" type="list_remove"/>
                    </actions>

                    <columns>
                        <!-- Normal catalog item -->
                        <column property="item" editable="true"/>

                        <!-- Is this a custom ad-hoc item? -->
                        <column property="customItem" header="Custom?" editable="true"/>

                        <!-- Free text name when customItem = true -->
                        <column property="customName" header="Custom name" editable="true"/>

                        <!-- Quantity (for normal items) or price (for custom items) -->
                        <column property="quantity" header="Qty / Price" editable="true"/>

                        <editorActionsColumn>
                            <editButton icon="PENCIL"/>
                            <saveButton icon="CHECK" themeNames="success"/>
                            <cancelButton icon="CLOSE" themeNames="error"/>
                        </editorActionsColumn>
                    </columns>
                </dataGrid>
            </vbox>

            <!-- RIGHT: big preview of selected item's image -->
            <vbox width="30%">
                <span text="Item photo preview"/>
                <!-- 🔹 This binds to the selected row's item.image -->
                <image id="itemPreview"
                       dataContainer="itemsDc"
                       property="item.image"
                       classNames="order-item-preview"/>
            </vbox>

        </hbox>

        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>

    </layout>
</view>
