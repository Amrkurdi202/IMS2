<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://ItemUnitPriceDetailView.title"
      focusComponent="form">

    <data>
        <instance id="itemUnitPriceDc"
                  class="com.ghazal.ims2.entity.ItemUnitPrice">
            <fetchPlan extends="_base">
                <property name="item" fetchPlan="_base"/>
                <property name="unit" fetchPlan="_base"/>
                <property name="price"/>
                <property name="warehouse" fetchPlan="_base"/>
            </fetchPlan>
            <loader/>
        </instance>
    </data>

    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_discard"/>
    </actions>

    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>

    <layout spacing="true" padding="true">
        <formLayout id="form" dataContainer="itemUnitPriceDc">

            <entityPicker id="itemField" property="item" required="true">
                <actions>
                    <action id="lookup" type="entity_lookup"/>
                    <action id="clear" type="entity_clear"/>
                </actions>
            </entityPicker>

            <entityPicker id="unitField" property="unit" required="true">
                <actions>
                    <action id="lookup" type="entity_lookup"/>
                    <action id="clear" type="entity_clear"/>
                </actions>
            </entityPicker>

            <bigDecimalField id="priceField"
                             property="price"
                             required="true"
                             clearButtonVisible="true"/>

            <entityPicker id="warehouseField" property="warehouse" required="true">
                <actions>
                    <action id="lookup" type="entity_lookup"/>
                    <action id="clear" type="entity_clear"/>
                </actions>
            </entityPicker>

            <textField id="barcodeField"
                       property="barcode"
                       label="msg://com.ghazal.ims2.view.itemunitprice/itemUnitPrice.barcode"
                       dataContainer="itemUnitPriceDc"
                       classNames="barcode"
                       clearButtonVisible="true"/>

        </formLayout>

        <hbox id="actionsBox" classNames="buttons-panel" spacing="true">
            <button id="saveAndCloseButton" action="saveAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
