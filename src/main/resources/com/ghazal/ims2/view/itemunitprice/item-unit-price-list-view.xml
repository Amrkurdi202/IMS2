<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://ItemUnitPriceListView.title"
      focusComponent="itemUnitPricesDataGrid">

    <data>
        <collection id="itemUnitPricesDc"
                    class="com.ghazal.ims2.entity.ItemUnitPrice">
            <fetchPlan extends="_base">
                <property name="item" fetchPlan="_base"/>
                <property name="unit" fetchPlan="_base"/>
                <property name="warehouse" fetchPlan="_base"/>
                <property name="price"/>
            </fetchPlan>

            <loader id="itemUnitPricesDl">
                <query><![CDATA[
                    select e from ItemUnitPrice e
                    where (:warehouse is null or e.warehouse = :warehouse)
                      and e.unit is not null
                    order by e.item.name
                ]]></query>
            </loader>
        </collection>
    </data>

    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>

    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>

    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="itemUnitPricesDl">
            <properties include=".*"/>
        </genericFilter>

        <hbox id="buttonsPanel" classNames="buttons-panel">
            <button id="createButton" action="itemUnitPricesDataGrid.create"/>
            <button id="editButton" action="itemUnitPricesDataGrid.edit"/>
            <button id="removeButton" action="itemUnitPricesDataGrid.remove"/>
            <button id="generateBarcodesBtn"
                    text="msg://com.ghazal.ims2.view.itemunitprice/itemUnitPrice.generateMissing"/>
            <simplePagination id="pagination" dataLoader="itemUnitPricesDl"/>
        </hbox>

        <dataGrid id="itemUnitPricesDataGrid"
                  width="100%"
                  columnReorderingAllowed="true"
                  minHeight="20em"
                  dataContainer="itemUnitPricesDc">
            <actions>
                <action id="create" type="list_create"/>
                <action id="edit" type="list_edit"/>
                <action id="remove" type="list_remove"/>
            </actions>

            <columns resizable="true">
                <column property="item"/>
                <column property="barcode" header="msg://com.ghazal.ims2.view.itemunitprice/itemUnitPrice.barcode"/>
                <column property="unit"/>
                <column property="price"/>
                <column property="warehouse"/>
                <column key="print" autoWidth="true" flexGrow="0"
                        header="msg://com.ghazal.ims2.view.itemunitprice/itemUnitPrice.printLabel"/>
            </columns>
        </dataGrid>

        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
