<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://attendanceDayListView.title"
      focusComponent="attendanceDaysDataGrid">

    <data>
        <collection id="attendanceDaysDc"
                    class="com.ghazal.ims2.entity.AttendanceDay">
            <fetchPlan extends="_base">
                <property name="user" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="attendanceDaysDl">
                <query>
                    <![CDATA[select e from AttendanceDay e]]>
                </query>
            </loader>
        </collection>
    </data>

    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>

    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>

    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="attendanceDaysDl">
            <properties include=".*"/>
        </genericFilter>

        <hbox id="buttonsPanel" classNames="buttons-panel">
            <button id="createButton"
                    action="attendanceDaysDataGrid.createAction"/>

            <!-- no edit button / no editAction -->

            <button id="removeButton"
                    action="attendanceDaysDataGrid.removeAction"/>

            <!-- this button will open the records list -->
            <button id="recordsButton"
                    text="View records"/>

            <simplePagination id="pagination"
                              dataLoader="attendanceDaysDl"/>
        </hbox>

        <dataGrid id="attendanceDaysDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="attendanceDaysDc"
                  columnReorderingAllowed="true">
            <!-- notice: no doubleClickAction attribute here,
                 and no <action id="editAction" ...> -->

            <actions>
                <action id="createAction" type="list_create"/>
                <action id="removeAction" type="list_remove"/>
            </actions>

            <columns resizable="true">
                <column property="user"/>
                <column property="day"/>
            </columns>
        </dataGrid>

        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
