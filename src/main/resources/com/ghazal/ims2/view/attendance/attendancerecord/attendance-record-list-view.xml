<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://attendanceRecordListView.title"
      focusComponent="attendanceRecordsDataGrid">

    <data>
        <collection id="attendanceRecordsDc"
                    class="com.ghazal.ims2.entity.AttendanceRecord">
            <fetchPlan extends="_base">
                <property name="project" fetchPlan="_instance_name"/>
            </fetchPlan>
            <loader id="attendanceRecordsDl">
                <query>
                    <![CDATA[
                        select e from AttendanceRecord e
                        where e.day.id = :dayId
                    ]]>
                </query>
            </loader>
        </collection>
    </data>

    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>

    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>

    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="attendanceRecordsDl">
            <properties include=".*"/>
        </genericFilter>

        <hbox id="buttonsPanel" classNames="buttons-panel">
            <!-- NEW: plain button, no action -->
            <button id="createButton" text="msg://com.ghazal.ims2.view.attendance/createRecord"/>

            <button id="removeButton"
                    action="attendanceRecordsDataGrid.removeAction"/>

            <button id="saveButton" text="msg://com.ghazal.ims2.view.attendance/saveChanges"/>

            <simplePagination id="pagination"
                              dataLoader="attendanceRecordsDl"/>
        </hbox>

        <dataGrid id="attendanceRecordsDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="attendanceRecordsDc"
                  columnReorderingAllowed="true"
                  editorBuffered="false">

            <actions>
                <!-- only remove; no list_create / list_edit -->
                <action id="removeAction" type="list_remove"/>
            </actions>

            <columns resizable="true">
                <!-- all three are editable inline -->
                <column property="action" editable="true"/>
                <column property="time" editable="true"/>
                <column property="project" editable="true"/>

                <editorActionsColumn width="8em" flexGrow="0">
                    <editButton text="msg://common.edit"/>
                    <closeButton text="msg://common.close"/>
                </editorActionsColumn>
            </columns>
        </dataGrid>

        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
