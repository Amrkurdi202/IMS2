<?xml version="1.0" encoding="UTF-8"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jmix/flowui/component"
      xmlns:layout="http://jmix.io/schema/flowui/layout"
      controller="com.ghazal.ims2.view.attendance.AttendanceView"
      title="Attendance Management"
      focusComponent="actionsBox">

    <data>
        <collection id="attendanceDc"
                    class="com.ghazal.ims2.entity.AttendanceRecord">
            <loader id="attendanceDl">
                <query>
                    <![CDATA[select r from AttendanceRecord r]]>
                </query>
            </loader>
        </collection>
    </data>

    <layout expand="recordsTable" spacing="true" margin="true">

        <c:vbox id="actionsBox" spacing="true" width="100%">
            <c:label value="Mark your attendance for today" stylename="h3"/>

            <c:hbox spacing="true">
                <c:button id="inButton" text="Check In"/>
                <c:button id="breakButton" text="Start Break"/>
                <c:button id="breakEndButton" text="End Break"/>
                <c:button id="outButton" text="Check Out"/>
            </c:hbox>
        </c:vbox>

        <c:dataGrid id="recordsTable"
                    width="100%"
                    dataContainer="attendanceDc">
            <c:columns>
                <c:column property="action" header="Action"/>
                <c:column property="time" header="Time"/>
            </c:columns>
        </c:dataGrid>

    </layout>
</view>
