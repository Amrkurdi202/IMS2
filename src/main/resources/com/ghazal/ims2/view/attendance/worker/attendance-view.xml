<?xml version="1.0" encoding="UTF-8"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:layout="http://jmix.io/schema/flowui/layout"
      title="msg://com.ghazal.ims2.view.attendance/AttendanceManagement.title"
      focusComponent="projectField">

    <data>
        <collection id="attendanceDc"
                    class="com.ghazal.ims2.entity.AttendanceRecord"/>

        <collection id="projectsDc" class="com.ghazal.ims2.entity.Project">
            <fetchPlan extends="_base">
                <property name="name"/>
            </fetchPlan>
            <loader id="projectsDl">
                <query><![CDATA[
                    select p from Project p order by p.name
                ]]></query>
            </loader>
        </collection>
    </data>

    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>

    <layout>
        <vbox spacing="true" padding="true">
            <entityComboBox id="projectField"
                            label="msg://com.ghazal.ims2.view.attendance/project"
                            metaClass="Project"
                            itemsContainer="projectsDc"
                            itemLabelGenerator="name"
                            width="20em"/>

            <hbox spacing="true">
                <button id="inButton" text="msg://com.ghazal.ims2.view.attendance/in"/>
                <button id="outButton" text="msg://com.ghazal.ims2.view.attendance/out"/>
            </hbox>

            <dataGrid id="attendanceGrid"
                      width="100%"
                      dataContainer="attendanceDc">
                <columns>
                    <column property="action"/>
                    <column property="time12h" header="msg://common.time"/>
                    <column property="project.name" header="msg://com.ghazal.ims2.view.attendance/project"/>
                </columns>
            </dataGrid>
        </vbox>
    </layout>
</view>
