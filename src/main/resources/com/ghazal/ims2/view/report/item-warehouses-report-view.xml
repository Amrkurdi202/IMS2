<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://com.ghazal.ims2.view.report/ItemWarehousesReportView.title"
      focusComponent="itemField">

    <data>
        <!-- Items dropdown -->
        <collection id="itemsDc" class="com.ghazal.ims2.entity.Item">
            <fetchPlan extends="_base"/>
            <loader id="itemsDl">
                <query><![CDATA[
                    select i from Item i order by i.name
                ]]></query>
            </loader>
        </collection>

        <!-- Grid data -->
        <collection id="itemUnitPricesDc" class="com.ghazal.ims2.entity.ItemUnitPrice">
            <fetchPlan extends="_base">
                <property name="warehouse" fetchPlan="_base"/>
                <property name="item" fetchPlan="_base"/>
                <property name="price"/>
            </fetchPlan>
            <loader id="itemUnitPricesDl">
                <query><![CDATA[
                    select iup from ItemUnitPrice iup
                    where iup.item = :item
                      and (
                        :q is null or :q = ''
                        or lower(iup.warehouse.name) like concat('%', lower(:q), '%')
                      )
                    order by iup.warehouse.name
                ]]></query>
            </loader>
        </collection>
    </data>

    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>

    <layout>
        <vbox spacing="true" padding="true">
            <hbox spacing="true" alignItems="END">

                <entityComboBox id="itemField"
                                metaClass="Item"
                                itemsContainer="itemsDc"
                                label="msg://com.ghazal.ims2.view.report/item"
                                width="380px"/>

                <textField id="qField"
                           label="msg://com.ghazal.ims2.view.report/searchWarehouse"
                           width="280px"/>

                <button id="searchBtn" text="msg://common.search"/>
                <button id="resetBtn" text="msg://common.reset"/>
            </hbox>

            <dataGrid id="grid"
                      dataContainer="itemUnitPricesDc"
                      width="100%">
                <columns>
                    <column property="warehouse.name" header="msg://common.warehouse"/>
                    <column key="type" header="msg://common.type"/>
                    <column property="price" header="msg://common.price"/>
                </columns>
            </dataGrid>
        </vbox>
    </layout>
</view>
