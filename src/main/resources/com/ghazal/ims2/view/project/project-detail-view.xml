<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://ProjectDetailView.title"
      focusComponent="form">

    <data>
        <instance id="projectDc"
                  class="com.ghazal.ims2.entity.Project">
            <fetchPlan extends="_base">
                <property name="rooms" fetchPlan="_base"/>
            </fetchPlan>
            <loader/>
            <collection id="roomsDc" property="rooms"/>
        </instance>
    </data>

    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>

    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>

    <layout>
        <formLayout id="form" dataContainer="projectDc">
            <textField id="nameField"
                       property="name"
                       required="true"/>
            <vbox>
                <image id="image" property="image" dataContainer="projectDc"/>
                <fileUploadField
                        dataContainer="projectDc"
                        id="imageField"
                        property="image"
                        clearButtonVisible="true"
                        fileNameVisible="true"/>
            </vbox>
        </formLayout>

        <vbox width="100%">
            <hbox classNames="buttons-panel">
                <button id="roomsCreateBtn" action="roomsDataGrid.create"/>
                <button id="roomsEditBtn" action="roomsDataGrid.edit"/>
                <button id="roomsRemoveBtn" action="roomsDataGrid.remove"/>
            </hbox>

            <dataGrid id="roomsDataGrid"
                      width="100%"
                      dataContainer="roomsDc"
                      editorBuffered="true"
                      allRowsVisible="true"
                      minHeight="15em">
                <actions>
                    <action id="create" type="list_create">
                        <properties>
                            <property name="openMode" value="DIALOG"/>
                        </properties>
                    </action>
                    <action id="edit" type="list_edit">
                        <properties>
                            <property name="openMode" value="DIALOG"/>
                        </properties>
                    </action>
                    <action id="remove" type="list_remove"/>
                </actions>

                <columns>
                    <column property="name" editable="true"/>
                </columns>
                <editorActionsColumn key="bufferedEditorColumn">
                    <editButton icon="PENCIL"/>
                    <saveButton icon="CHECK" themeNames="success"/>
                    <cancelButton icon="CLOSE" themeNames="error"/>
                </editorActionsColumn>
            </dataGrid>
        </vbox>

        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
