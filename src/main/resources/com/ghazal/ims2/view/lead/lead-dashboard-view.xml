<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://com.ghazal.ims2.view.lead/LeadDashboardView.title"
      focusComponent="attendanceTable">

    <data>
        <collection id="attendanceDc"
                    class="com.ghazal.ims2.entity.AttendanceRecord"/>

        <collection id="warehousesDc" class="com.ghazal.ims2.entity.Warehouse">
            <fetchPlan extends="_base">
                <property name="name"/>
            </fetchPlan>
            <loader id="warehousesDl">
                <query><![CDATA[
                    select w from Warehouse w order by w.name
                ]]></query>
            </loader>
        </collection>

        <collection id="projectsDc" class="com.ghazal.ims2.entity.Project">
            <fetchPlan extends="_base">
                <property name="name"/>
            </fetchPlan>
            <loader id="projectsDl">
                <query><![CDATA[
                    select p from Project p order by p.name
                ]]></query>
            </loader>
        </collection>

        <keyValueCollection id="quickItemsDc">
            <properties>
                <property name="item"            type="string"/>
                <property name="unit"            type="string"/>
                <property name="itemUnitPriceId" type="string"/>
                <property name="warehouse"       type="string"/>
                <property name="project"         type="string"/>
                <property name="quantity"        type="string"/>
            </properties>
        </keyValueCollection>
    </data>

    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>

    <layout>
        <vbox width="100%" padding="true" spacing="true">

            <!-- ======== ATTENDANCE ======== -->
            <details summaryText="msg://com.ghazal.ims2.view.lead/attendanceManagement" opened="true">
                <vbox spacing="true" width="100%">

                    <hbox spacing="true" width="100%">
                        <button id="inBtn"       text="msg://com.ghazal.ims2.view.attendance/in"          themeNames="primary small"/>
                        <button id="outBtn"      text="msg://com.ghazal.ims2.view.attendance/out"         themeNames="small"/>
                        <button id="breakBtn"    text="msg://com.ghazal.ims2.view.attendance/breakStart" themeNames="small"/>
                        <button id="breakEndBtn" text="msg://com.ghazal.ims2.view.attendance/breakEnd"   themeNames="small"/>
                    </hbox>

                    <dataGrid id="attendanceTable"
                              dataContainer="attendanceDc"
                              width="100%"
                              allRowsVisible="true">
                        <columns>
                            <column property="action"/>
                            <column property="time"/>
                        </columns>
                    </dataGrid>

                </vbox>
            </details>

            <span text="" classNames="mt-s"/>

            <!-- ======== QUICK ITEMS ======== -->
            <span text="msg://com.ghazal.ims2.view.lead/quickItems" classNames="text-xl font-semibold"/>

            <hbox spacing="true" width="100%">
                <textField id="itemsSearchField"
                           width="100%"
                           placeholder="msg://com.ghazal.ims2.view.lead/searchItems"/>
                <button id="itemsSearchBtn" icon="vaadin:search"/>
            </hbox>

            <div id="itemsCardsContainer" classNames="items-grid mt-m">

                <vbox id="customItemCard"
                      padding="true"
                      spacing="true"
                      classNames="item-card custom-full border rounded-l shadow-s">

                    <span text="msg://com.ghazal.ims2.view.order/customItem" classNames="font-semibold"/>

                    <textField id="customItemNameField"
                               width="100%"
                               placeholder="msg://com.ghazal.ims2.view.lead/enterCustomItemName"/>

                    <button id="addCustomItemBtn"
                            width="100%"
                            themeNames="small"
                            text="msg://com.ghazal.ims2.view.lead/addCustom"
                            enabled="false"/>
                </vbox>

            </div>

            <hbox spacing="true" classNames="mt-m" width="100%">
                <comboBox id="warehouseCombo"
                          label="msg://com.ghazal.ims2.view.lead/warehouse"
                          width="100%"/>
                <comboBox id="projectCombo"
                          label="msg://com.ghazal.ims2.view.lead/project"
                          width="100%"/>
            </hbox>

            <dataGrid id="quickItemsTable"
                      dataContainer="quickItemsDc"
                      width="100%"
                      allRowsVisible="true">
                <columns>
                    <column property="item"      header="Item"/>
                    <column property="unit"      header="Unit"/>
                    <column property="quantity"  header="Qty"/>
                    <column property="warehouse" header="Warehouse"/>
                    <column property="project"   header="Project"/>
                </columns>
            </dataGrid>

            <hbox spacing="true" classNames="mt-s">
                <button id="decreaseQtyBtn" text="msg://com.ghazal.ims2.view.lead/decrease"/>
                <button id="increaseQtyBtn" text="msg://com.ghazal.ims2.view.lead/increase"/>
                <button id="deleteLineBtn" text="msg://common.delete"/>
                <button id="saveOrderBtn"
                        text="msg://com.ghazal.ims2.view.lead/saveOrder"
                        themeNames="primary"
                        classNames="ml-auto"/>
            </hbox>

        </vbox>
    </layout>

</view>
