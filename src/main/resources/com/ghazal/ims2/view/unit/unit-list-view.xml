<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://UnitListView.title"
      focusComponent="unitsDataGrid">

    <data>
        <collection id="unitsDc"
                    class="com.ghazal.ims2.entity.Unit">
            <fetchPlan extends="_base">
                <property name="name"/>
            </fetchPlan>

            <loader id="unitsDl">
                <query><![CDATA[
                    select e from Unit e order by e.name
                ]]></query>
            </loader>
        </collection>
    </data>

    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>

    <layout>
        <genericFilter id="genericFilter" dataLoader="unitsDl">
            <properties include=".*"/>
        </genericFilter>

        <hbox id="buttonsPanel" classNames="buttons-panel">
            <button id="createButton" action="unitsDataGrid.create"/>
            <button id="editButton" action="unitsDataGrid.edit"/>
            <button id="removeButton" action="unitsDataGrid.remove"/>
            <simplePagination id="pagination" dataLoader="unitsDl"/>
        </hbox>

        <dataGrid id="unitsDataGrid"
                  width="100%"
                  columnReorderingAllowed="true"
                  minHeight="20em"
                  dataContainer="unitsDc">

            <actions>
                <action id="create" type="list_create"/>
                <action id="edit" type="list_edit"/>
                <action id="remove" type="list_remove"/>
            </actions>

            <columns resizable="true">
                <column property="name"/>
            </columns>
        </dataGrid>
    </layout>
</view>
