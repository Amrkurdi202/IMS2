<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://ProjectPointDetailView.title"
      focusComponent="form">
    <data>
        <instance id="ProjectPointDc"
                  class="com.ghazal.ims2.entity.ProjectPoint">

            <fetchPlan extends="_base">
                <property name="point" fetchPlan="_base"/>
                <property name="room" fetchPlan="_base"/>
            </fetchPlan>

            <loader/>
        </instance>
    </data>

    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_discard"/>
    </actions>

    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>

    <layout>
        <formLayout id="form" dataContainer="ProjectPointDc">

            <entityPicker id="pointField" property="point" required="true" dataContainer="ProjectPointDc"
                          metaClass="Point">
                <actions>
                    <action id="lookup" type="entity_lookup"/>
                    <action id="clear" type="entity_clear"/>
                </actions>
            </entityPicker>

            <entityPicker id="roomField" property="room" required="true" dataContainer="ProjectPointDc"
                          metaClass="Room" enabled="false"/>

            <bigDecimalField id="quantityField" property="quantity"/>

        </formLayout>

        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
