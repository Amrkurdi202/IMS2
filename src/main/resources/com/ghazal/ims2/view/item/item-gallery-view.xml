<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="Item gallery"
      focusComponent="itemsGrid">

    <data>
        <collection id="itemsDc"
                    class="com.ghazal.ims2.entity.Item">
            <fetchPlan extends="_base">
                <property name="image"/>
            </fetchPlan>
            <loader id="itemsDl">
                <query>
                    <![CDATA[select e from Item e order by e.name]]>
                </query>
            </loader>
        </collection>
    </data>

    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>

    <layout>

        <dataGrid id="itemsGrid"
                  dataContainer="itemsDc"
                  width="100%"
                  minHeight="30em"
                  classNames="item-gallery-grid"
                  themeNames="wrap-cell-content">

            <columns>
                <column property="name" header="Name"/>

                <!-- The cell will show a big image -->
                <column property="image" header="Photo"/>
            </columns>
        </dataGrid>

        <hbox spacing="true">
            <button id="selectBtn" text="Select"/>
            <button id="closeBtn" text="Close"/>
        </hbox>

    </layout>
</view>
