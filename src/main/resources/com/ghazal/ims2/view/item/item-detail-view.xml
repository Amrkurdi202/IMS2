<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://ItemDetailView.title"
      focusComponent="form">
    <data>
        <instance id="itemDc"
                  class="com.ghazal.ims2.entity.Item">
            <fetchPlan extends="_base"/>
            <loader id="itemDl"/>
        </instance>
    </data>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>

    <layout>
        <formLayout id="form" dataContainer="itemDc">
            <vbox>
                <textField id="nameField" property="name" required="true" dataContainer="itemDc"/>
                <image id="image" property="image" dataContainer="itemDc"/>
                <fileUploadField
                        dataContainer="itemDc"
                        id="imageField"
                                 property="image"
                                 clearButtonVisible="true"
                                 fileNameVisible="true"/>
            </vbox>
        </formLayout>

        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
