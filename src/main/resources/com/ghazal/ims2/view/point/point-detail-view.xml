<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://PointDetailView.title"
      focusComponent="form">
    <data>
        <instance id="pointDc"
                  class="com.ghazal.ims2.entity.Point">
            <fetchPlan extends="_base"/>
            <loader/>
        </instance>
    </data>

    <actions>
        <action id="closeAction" type="detail_discard"/>
    </actions>

    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>

    <layout>
        <formLayout id="form" dataContainer="pointDc">
            <textField id="nameField" property="name" required="true"/>
            <bigDecimalField id="factorField" property="factor"/>
            <vbox>
                <image id="image" property="image" dataContainer="pointDc" classNames="app-image"/>
                <fileUploadField id="imageField"
                                 dataContainer="pointDc"
                                 property="image"
                                 clearButtonVisible="true"
                                 fileNameVisible="true"/>
            </vbox>
        </formLayout>

        <hbox id="detailActions">
            <button id="saveAndCloseButton" text="msg://common.ok"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
