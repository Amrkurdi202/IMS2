<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <!-- quantity was DECIMAL(10,0) via bare DECIMAL: silently rounded 2.5 -> 3, 8.8 -> 9.
         Decimal quantities are required (meters, lengths). -->
    <changeSet id="10-order-item-quantity-scale" author="amr">
        <modifyDataType tableName="order_item" columnName="quantity" newDataType="DECIMAL(13,3)"/>
    </changeSet>

</databaseChangeLog>