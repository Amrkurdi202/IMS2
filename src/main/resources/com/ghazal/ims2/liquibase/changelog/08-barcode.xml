<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <changeSet id="08-barcode-1" author="amr">
        <addColumn tableName="item">
            <column name="barcode" type="VARCHAR(100)"/>
        </addColumn>
    </changeSet>

    <changeSet id="08-barcode-2" author="amr">
        <createIndex tableName="item" indexName="ux_item_barcode" unique="true">
            <column name="barcode"/>
        </createIndex>
    </changeSet>

    <changeSet id="08-barcode-3" author="amr">
        <addColumn tableName="warehouse">
            <column name="latitude" type="DOUBLE"/>
            <column name="longitude" type="DOUBLE"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>