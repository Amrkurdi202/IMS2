<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <!-- App-level key/value settings: n8n sync config + revision, MCP token. -->
    <changeSet id="11-app-setting" author="amr">
        <createTable tableName="app_setting">
            <column name="ID" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_app_setting"/>
            </column>
            <column name="SETTING_KEY" type="VARCHAR(64)">
                <constraints nullable="false" unique="true" uniqueConstraintName="ux_app_setting_key"/>
            </column>
            <column name="SETTING_VALUE" type="VARCHAR(4000)"/>
        </createTable>

        <insert tableName="app_setting">
            <column name="SETTING_KEY" value="n8n.revision"/>
            <column name="SETTING_VALUE" value="0"/>
        </insert>
        <insert tableName="app_setting">
            <column name="SETTING_KEY" value="n8n.sync_revision"/>
            <column name="SETTING_VALUE" value="0"/>
        </insert>
        <insert tableName="app_setting">
            <column name="SETTING_KEY" value="n8n.sync_at"/>
            <column name="SETTING_VALUE" value=""/>
        </insert>
        <insert tableName="app_setting">
            <column name="SETTING_KEY" value="n8n.sync_error"/>
            <column name="SETTING_VALUE" value=""/>
        </insert>
    </changeSet>

</databaseChangeLog>
